# D11 portable shared-hosting rewrite rules
# Avoid Options directives: some shared hosts reject them and return HTTP 500.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Standalone sitemap and dynamic robots.txt.
RewriteRule ^sitemap\\.xml$ sitemap.php [L,NC]
RewriteRule ^robots\\.txt$ robots.php [L,NC]

# Block private folders if the host accidentally exposes the project root.
RewriteRule ^(?:app|config|database|storage|vendor)(?:/|$) - [F,L,NC]

# Block dotfiles except ACME validation.
RewriteCond %{REQUEST_URI} !^/\\.well-known/
RewriteRule (^|/)\\.(?!well-known/) - [F,L]

# Existing files/directories (assets and installer) bypass the router.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route clean SEO URLs through the front controller.
RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Protect sensitive file extensions if they are ever placed in the public root.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)(^\\.env|\\.(ini|log|sql|bak|dist|lock)$)">
    Require all denied
  </FilesMatch>
</IfModule>
